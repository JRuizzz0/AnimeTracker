<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.animetracker.controller.AnimeController"
      spacing="15" alignment="CENTER"
      stylesheets="@style.css"
      styleClass="root">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Mi Lista de Anime" styleClass="titulo-label"/>

    <TableView fx:id="tablaAnimes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="150"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="colTotalEp" text="Eps" prefWidth="70"/>
            <TableColumn fx:id="colVistosEp" text="Vistos" prefWidth="70"/>
            <TableColumn fx:id="colPuntuacion" text="Nota" prefWidth="50"/>
        </columns>
    </TableView>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <TextField fx:id="txtTitulo" promptText="Título del Anime" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="200"/>
        <ComboBox fx:id="comboGenero" promptText="Género" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="150"/>

        <TextField fx:id="txtTotalEp" promptText="Total Eps" GridPane.columnIndex="0" GridPane.rowIndex="1" prefWidth="90"/>
        <TextField fx:id="txtVistosEp" promptText="Eps Vistos" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="90"/>

        <TextField fx:id="txtPuntuacion" promptText="Nota (0-10)" GridPane.columnIndex="0" GridPane.rowIndex="2" prefWidth="90"/>
        <ComboBox fx:id="comboEstado" promptText="Estado" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="150"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Añadir" onAction="#Guardar" styleClass="btn-guardar"/>
        <Button text="Actualizar" onAction="#Actualizar" styleClass="btn-actualizar"/>
        <Button text="Eliminar" onAction="#Eliminar" styleClass="btn-eliminar"/>
        <Button text="Catálogo" onAction="#irAlCatalogo" styleClass="btn-catalogo"/>
    </HBox>
</VBox>